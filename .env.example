# ---------------------------------------------------------------------------
# Catatan Stok Bisnis — contoh konfigurasi environment
#
# Salin ke .env lalu sesuaikan:
#   cp .env.example .env
#   php artisan key:generate
#
# Nilai yang WAJIB diisi: APP_KEY, DB_*, ADMIN_*
# ---------------------------------------------------------------------------

APP_NAME="Bisnis HP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bisnis.muzakie.my.id
# Dipakai untuk URL absolut asset (Vite) — samakan dengan APP_URL di produksi
ASSET_URL=https://bisnis.muzakie.my.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Naikkan saat produksi (default 12 sudah cukup)
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Database (MySQL / MariaDB) -------------------------------------------
# Wajib mysql: app memakai session, cache, dan queue dari database,
# jadi tabel users, cache, sessions, jobs harus ada.
DB_CONNECTION=mysql
DB_HOST=mysql_db
DB_PORT=3306
DB_DATABASE=catatan-stok-new
DB_USERNAME=root
DB_PASSWORD=

# --- Session ----------------------------------------------------------------
#WAJIB database: login memakai session driver database.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi memakai HTTPS -> cookie hanya dikirim via koneksi aman
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Cache ------------------------------------------------------------------
# WAJIB database: Livewire memakai cache database.
CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Akun admin pertama -----------------------------------------------------
# Dipakai oleh `php artisan db:seed` (database/seeders/AdminSeeder.php).
# Seeder idempoten: kalau email sudah ada, akun tidak dibuat ulang.
# Setelah seeding, hapus ADMIN_PASSWORD dari .env demi keamanan.
ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@muzakie.my.id
ADMIN_PASSWORD=

# --- Email (opsional, belum dipakai fitur apa pun) --------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Redis / Memcached (opsional, tidak dipakai di default) -----------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# --- AWS / S3 (opsional) ---------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"